    {
      "name": "3. LAB 4 y 5 - Pruebas de Chaos Engineering",
      "description": "Peticiones para verificar los escenarios de fallo",
      "item": [
        {
          "name": "3.1 Probar Orden con Catálogo Caído (Esperado: 503)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 503 Service Unavailable\", function () {",
                  "    pm.response.to.have.status(503);",
                  "});",
                  "pm.test(\"Detalle indica Catalog service unavailable\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.detail).to.eql(\"Catalog service unavailable\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8002/orders?space_id=1&user_email=chaos@test.com&hours=2",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8002",
              "path": ["orders"],
              "query": [
                {
                  "key": "space_id",
                  "value": "1"
                },
                {
                  "key": "user_email",
                  "value": "chaos@test.com"
                },
                {
                  "key": "hours",
                  "value": "2"
                }
              ]
            }
          },
          "response": []
